<script>

const slides = document.querySelectorAll(".slide");

let atual = 0;

function iniciarMusica() {

    document.getElementById("inicio").style.display = "none";

    document.getElementById("controles").classList.add("ativo");

    document.getElementById("numero").classList.add("ativo");

    mostrarSlide(0);
}

function mostrarSlide(n) {

    slides.forEach(slide => {
        slide.classList.remove("ativo");
    });

    atual = Math.max(0, Math.min(n, slides.length - 1));

    slides[atual].classList.add("ativo");

    document.getElementById("numero").textContent =
        (atual + 1) + " / " + slides.length;
}

function proximo() {

    if (atual < slides.length - 1) {
        mostrarSlide(atual + 1);
    }
}

function anterior() {

    if (atual > 0) {
        mostrarSlide(atual - 1);
    }
}

document.addEventListener("keydown", function(event) {

    if (event.key === "ArrowRight") {
        proximo();
    }

    if (event.key === "ArrowLeft") {
        anterior();
    }

});

</script>

